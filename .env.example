# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_ or commit it.
SUPABASE_SECRET_KEY=

# Web Push VAPID keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# Random server-only value used to hash notification signup rate-limit keys.
PUSH_RATE_LIMIT_SECRET=

# Optional Playwright credentials. Omit them to skip the authenticated journeys.
# E2E_ADMIN_EMAIL must be a regular administrator, not the super administrator.
# E2E_SETUP_EMAIL must still be required to replace a temporary password.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_SETUP_EMAIL=
# E2E_SETUP_PASSWORD=
